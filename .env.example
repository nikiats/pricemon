# Скопируйте в .env и заполните: cp .env.example .env
# Файл читают и приложения (godotenv), и Makefile.

# Своя база у каждого сервиса. Используются целями migrate-* и run-*;
# в приложение уходят как DATABASE_URL.
WEB_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pricemon_web?sslmode=disable
PRICEMON_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pricemon_offers?sslmode=disable
DEALMANAGER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pricemon_deals?sslmode=disable

# Ключ подписи JWT. Задайте свой, например: openssl rand -hex 32
JWT_SECRET=

# Необязательное — значения ниже совпадают с умолчаниями в конфиге.
# PORT=8080
# ACCESS_TOKEN_TTL=15m
# BCRYPT_COST=12
