WEB_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pricemon_web?sslmode=disable
PRICEMON_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pricemon_offers?sslmode=disable
DEALMANAGER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pricemon_deals?sslmode=disable

DATABASE_MIGRATE=true

# Ключ подписи JWT. Пример генерации: openssl rand -hex 32
JWT_SECRET=

# PORT=8080
# ACCESS_TOKEN_TTL=15m
# BCRYPT_COST=12

# Адреса внутренних сервисов, куда web проксирует запросы.
PRICEMON_URL=http://localhost:8080
DEALMANAGER_URL=http://localhost:8080

# Свой токен на каждый внутренний сервис: web представляется ими,
# сервис сверяет свой со значением SERVICE_TOKEN в своём окружении.
PRICEMON_SERVICE_TOKEN=example-97a9e81c9d4b0eb7891c803f8be30d52d1348b91440ebfcba37f5fb8a056b7e4
DEALMANAGER_SERVICE_TOKEN=
